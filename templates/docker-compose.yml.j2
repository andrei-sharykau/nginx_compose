services:
  nginx:
    image: {{ nginx_compose_nginx_image }}
    container_name: nginx-compose-nginx
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - {{ nginx_compose_dir }}/conf/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ nginx_compose_dir }}/conf/conf.d:/etc/nginx/conf.d:ro
      - {{ nginx_compose_dir }}/html:/var/www/html:ro
      - {{ nginx_compose_dir }}/auth:/etc/nginx/auth:ro
      - {{ nginx_compose_dir }}/certbot/conf:/etc/letsencrypt:ro
      - {{ nginx_compose_dir }}/certbot/www:/var/www/certbot:ro
      - {{ nginx_compose_dir }}/logs:/var/log/nginx
    networks:
      - nginx_compose

  # One-shot only: docker compose run --rm certbot … (not started by up -d)
  certbot:
    image: {{ nginx_compose_certbot_image }}
    profiles:
      - certbot
    volumes:
      - {{ nginx_compose_dir }}/certbot/conf:/etc/letsencrypt
      - {{ nginx_compose_dir }}/certbot/www:/var/www/certbot
    networks:
      - nginx_compose

networks:
  nginx_compose:
    driver: bridge
